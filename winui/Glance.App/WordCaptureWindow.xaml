<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Glance.App.WordCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.App"
    Title="Glance 划词">

    <!-- Full-bleed opaque root so nothing under the window shows through. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border
            Margin="1"
            Padding="12,10"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel Spacing="6" MaxWidth="320">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="HeadwordText"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Click="OnCloseClick"
                        Padding="6,2"
                        MinWidth="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="✕"
                        FontSize="12"
                        Opacity="0.7" />
                </Grid>
                <TextBlock
                    x:Name="PhoneticText"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ItemsControl x:Name="SenseList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DictSenseRow">
                            <Grid ColumnSpacing="8" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind Pos}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Opacity="0.9"
                                    Text="{x:Bind Meaning}"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="StatusText"
                    FontSize="11"
                    Opacity="0.65"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
