<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glance.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Glance.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: languages + actions -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="FromLangBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnLangChanged" />
            <Button
                x:Name="SwapLangButton"
                Grid.Column="1"
                Click="OnSwapLang"
                Content="⇄"
                ToolTipService.ToolTip="交换语言" />
            <ComboBox
                x:Name="ToLangBox"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnLangChanged" />
            <ToggleButton
                x:Name="PinButton"
                Grid.Column="3"
                Click="OnPinClick"
                Content="📌"
                ToolTipService.ToolTip="置顶窗口" />
            <Button
                x:Name="CaptureButton"
                Grid.Column="4"
                Click="OnCaptureClick"
                Content="截屏翻译"
                Style="{StaticResource AccentButtonStyle}" />
            <ToggleButton
                x:Name="SettingsButton"
                Grid.Column="5"
                Click="OnSettingsToggle"
                Content="⚙"
                ToolTipService.ToolTip="设置" />
        </Grid>

        <!-- Text translate -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                AcceptsReturn="True"
                PlaceholderText="输入要翻译的文本…"
                TextChanged="OnInputChanged"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="OutputBox"
                Grid.Column="1"
                AcceptsReturn="True"
                IsReadOnly="True"
                PlaceholderText="译文"
                TextWrapping="Wrap" />
        </Grid>

        <!-- Settings -->
        <Border
            x:Name="SettingsPanel"
            Grid.Row="2"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="设置" />
                <TextBlock Opacity="0.7" Text="文本引擎：必应（MVP）" />
                <ToggleSwitch
                    x:Name="AutostartSwitch"
                    Header="开机自启"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnAutostartToggled" />
                <TextBox
                    x:Name="HotkeyBox"
                    Header="截屏翻译热键"
                    LostFocus="OnHotkeyCommit" />
                <TextBox
                    x:Name="CopyHotkeyBox"
                    Header="OCR 复制热键"
                    LostFocus="OnHotkeyCommit" />
                <TextBox
                    x:Name="PopupHotkeyBox"
                    Header="弹出主窗热键（可空）"
                    LostFocus="OnHotkeyCommit" />
                <TextBlock
                    x:Name="StatusText"
                    Opacity="0.6"
                    Text=""
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
