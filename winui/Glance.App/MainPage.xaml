<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glance.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="14,6,14,8" RowSpacing="8" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="FromLangBox"
                Grid.Column="0"
                MinWidth="108"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                SelectionChanged="OnLangChanged" />
            <Button
                x:Name="SwapLangButton"
                Grid.Column="1"
                Click="OnSwapLang"
                Style="{StaticResource GlanceToolbarButtonStyle}"
                ToolTipService.ToolTip="交换语言">
                <FontIcon
                    x:Name="SwapLangIcon"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Glyph="&#xE8AB;"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform x:Name="SwapLangRotate" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <ComboBox
                x:Name="ToLangBox"
                Grid.Column="2"
                MinWidth="108"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                SelectionChanged="OnLangChanged" />

            <StackPanel
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="2">
                <ToggleButton
                    x:Name="PinButton"
                    Click="OnPinClick"
                    Style="{StaticResource GlanceToolbarToggleStyle}"
                    ToolTipService.ToolTip="置顶窗口">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE840;" />
                </ToggleButton>
                <Button
                    x:Name="CaptureButton"
                    Click="OnCaptureClick"
                    Style="{StaticResource GlanceCaptureButtonStyle}"
                    ToolTipService.ToolTip="截屏翻译">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE7A8;" Foreground="White" />
                </Button>
                <Button
                    x:Name="WordbookButton"
                    Click="OnWordbookClick"
                    Style="{StaticResource GlanceToolbarButtonStyle}"
                    ToolTipService.ToolTip="生词本">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE82D;" />
                </Button>
                <Button
                    x:Name="ThemeButton"
                    Click="OnThemeToggle"
                    Style="{StaticResource GlanceThemeToggleStyle}"
                    ToolTipService.ToolTip="切换浅色/深色主题" />
                <Button
                    x:Name="SettingsButton"
                    Click="OnSettingsClick"
                    Style="{StaticResource GlanceToolbarButtonStyle}"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Source / target panes -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Padding="10,8,8,6" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="原文" />
                            <TextBlock
                                x:Name="InputMetaText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="自动识别"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            x:Name="InputClearButton"
                            HorizontalAlignment="Right"
                            Click="OnClearInputClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            ToolTipService.ToolTip="清空">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="140"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <TextBox
                                x:Name="InputBox"
                                MinHeight="44"
                                AcceptsReturn="True"
                                BorderThickness="0"
                                FontSize="16"
                                Padding="0"
                                PlaceholderText="输入或粘贴要翻译的文本…"
                                TextChanged="OnInputChanged"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="InputPinyinText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="InputCopyButton"
                            Click="OnCopyClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            Tag="input"
                            ToolTipService.ToolTip="复制原文">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8C8;" />
                        </Button>
                        <Button
                            x:Name="SaveWordButton"
                            Click="OnSaveWordClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            ToolTipService.ToolTip="加入本地生词本">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE735;" />
                        </Button>
                        <Button
                            x:Name="InputTtsButton"
                            Click="OnTtsClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            Tag="input"
                            ToolTipService.ToolTip="朗读原文" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Padding="10,8,8,6" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="译文" />
                        <TextBlock
                            x:Name="OutputMetaText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text=""
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="140"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <TextBox
                                x:Name="OutputBox"
                                MinHeight="44"
                                AcceptsReturn="True"
                                BorderThickness="0"
                                FontSize="16"
                                IsReadOnly="True"
                                Padding="0"
                                PlaceholderText="译文"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="OutputPinyinText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="RefreshTranslateButton"
                            Click="OnRefreshTranslateClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            ToolTipService.ToolTip="重新翻译">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            x:Name="OutputCopyButton"
                            Click="OnCopyClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            Tag="output"
                            ToolTipService.ToolTip="复制译文">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8C8;" />
                        </Button>
                        <Button
                            x:Name="OutputTtsButton"
                            Click="OnTtsClick"
                            Style="{StaticResource GlancePaneActionButtonStyle}"
                            Tag="output"
                            ToolTipService.ToolTip="朗读译文" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Dictionary: compact sense rows + alternatives -->
        <Border
            x:Name="DictPanel"
            Grid.Row="2"
            Padding="10,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="DictPhoneticText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap"
                    Visibility="Collapsed" />
                <ItemsControl x:Name="DictSenseList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DictSenseRow">
                            <Grid ColumnSpacing="8" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    MinWidth="36"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind Pos}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Opacity="0.9"
                                    Text="{x:Bind Meaning}"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="DictAltBlock" Spacing="2" Visibility="Collapsed">
                    <TextBlock
                        x:Name="DictAltTitle"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="其他表达" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DictAltList" Orientation="Horizontal" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="就绪"
            TextWrapping="Wrap" />
    </Grid>
</Page>
