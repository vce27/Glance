<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glance.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Glance.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="FromLangBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                SelectionChanged="OnLangChanged" />
            <Button
                x:Name="SwapLangButton"
                Grid.Column="1"
                Click="OnSwapLang"
                Content="⇄"
                Style="{StaticResource GlanceGhostButtonStyle}"
                ToolTipService.ToolTip="交换语言" />
            <ComboBox
                x:Name="ToLangBox"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                SelectionChanged="OnLangChanged" />
            <Button
                x:Name="TtsButton"
                Grid.Column="3"
                Click="OnTtsClick"
                Content="🔊"
                Style="{StaticResource GlanceGhostButtonStyle}"
                ToolTipService.ToolTip="朗读原文" />
            <ToggleButton
                x:Name="PinButton"
                Grid.Column="4"
                Click="OnPinClick"
                Content="📌"
                Style="{StaticResource GlancePinToggleStyle}"
                ToolTipService.ToolTip="置顶窗口" />
            <Button
                x:Name="CaptureButton"
                Grid.Column="5"
                Click="OnCaptureClick"
                Content="截屏翻译"
                Style="{StaticResource GlancePrimaryButtonStyle}" />
            <ToggleButton
                x:Name="ThemeButton"
                Grid.Column="6"
                Click="OnThemeToggle"
                Content="🌙"
                Style="{StaticResource GlancePinToggleStyle}"
                ToolTipService.ToolTip="切换浅色/深色主题" />
            <ToggleButton
                x:Name="SettingsButton"
                Grid.Column="7"
                Click="OnSettingsToggle"
                Content="⚙"
                Style="{StaticResource GlancePinToggleStyle}"
                ToolTipService.ToolTip="设置" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                AcceptsReturn="True"
                HorizontalAlignment="Stretch"
                PlaceholderText="输入要翻译的文本…"
                TextChanged="OnInputChanged"
                TextWrapping="Wrap"
                VerticalAlignment="Stretch" />
            <TextBox
                x:Name="OutputBox"
                Grid.Column="1"
                AcceptsReturn="True"
                HorizontalAlignment="Stretch"
                IsReadOnly="True"
                PlaceholderText="译文"
                TextWrapping="Wrap"
                VerticalAlignment="Stretch" />
        </Grid>

        <ScrollViewer
            x:Name="SettingsScroller"
            Grid.Row="2"
            MaxHeight="360"
            Visibility="Collapsed">
            <Border
                x:Name="SettingsPanel"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="设置" />

                    <TextBlock Text="文本引擎" />
                    <VariableSizedWrapGrid
                        x:Name="EngineList"
                        ItemHeight="40"
                        ItemWidth="88"
                        Orientation="Horizontal" />

                    <TextBlock Text="代理" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="ProxySystem" Content="系统代理" GroupName="Proxy" Checked="OnProxyChanged" />
                        <RadioButton x:Name="ProxyCustom" Content="自定义" GroupName="Proxy" Checked="OnProxyChanged" />
                        <RadioButton x:Name="ProxyNone" Content="不使用" GroupName="Proxy" Checked="OnProxyChanged" />
                    </StackPanel>
                    <TextBox
                        x:Name="CustomProxyBox"
                        Header="自定义代理 URL"
                        LostFocus="OnSettingsFieldCommit"
                        Visibility="Collapsed" />

                    <StackPanel x:Name="LlmPanel" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="LlmBaseUrlBox" Header="LLM Base URL" LostFocus="OnSettingsFieldCommit" />
                        <PasswordBox x:Name="LlmApiKeyBox" Header="API Key" PasswordChanged="OnLlmApiKeyChanged" />
                        <TextBox x:Name="LlmModelBox" Header="Model" LostFocus="OnSettingsFieldCommit" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="ThemeSwitch"
                        Header="深色主题"
                        OffContent="浅色"
                        OnContent="深色"
                        Toggled="OnThemeSwitchToggled" />
                    <ToggleSwitch
                        x:Name="AutostartSwitch"
                        Header="开机自启"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnAutostartToggled" />
                    <TextBox x:Name="HotkeyBox" Header="截屏翻译热键" LostFocus="OnHotkeyCommit" />
                    <TextBox x:Name="CopyHotkeyBox" Header="OCR 复制热键" LostFocus="OnHotkeyCommit" />
                    <TextBox x:Name="PopupHotkeyBox" Header="弹出主窗热键（可空）" LostFocus="OnHotkeyCommit" />
                    <TextBlock x:Name="StatusText" Opacity="0.6" Text="" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
