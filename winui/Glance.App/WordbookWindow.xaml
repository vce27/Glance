<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Glance.App.WordbookWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.App"
    Title="生词本">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="生词本" />
        <Grid Grid.Row="1" Padding="16,8,16,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="EmptyText"
                Opacity="0.7"
                Text="还没有词条。在翻译窗口点 ★ 加入。"
                TextWrapping="Wrap" />
            <ListView
                x:Name="WordList"
                Grid.Row="1"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WordbookRow">
                        <Grid ColumnSpacing="8" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Word}" TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="{x:Bind Phonetic}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasPhonetic}" />
                                <TextBlock
                                    Opacity="0.75"
                                    Text="{x:Bind Translation}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinWidth="32"
                                Click="OnSpeakClick"
                                Style="{StaticResource GlanceToolbarButtonStyle}"
                                Tag="{x:Bind Word}"
                                ToolTipService.ToolTip="朗读">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE767;" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                MinWidth="32"
                                Click="OnDeleteClick"
                                Content="删"
                                Style="{StaticResource GlanceToolbarButtonStyle}"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="删除" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
