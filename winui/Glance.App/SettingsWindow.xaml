<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Glance.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="设置" />
        <ScrollViewer Grid.Row="1" Padding="16,8,16,16">
            <StackPanel Spacing="12" MaxWidth="480">
                <ToggleSwitch
                    x:Name="WordCaptureSwitch"
                    Header="划词取词"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnToggle" />
                <TextBlock
                    Opacity="0.65"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="拖选单词弹出词典。浏览器用复制取词；终端/IDE 用屏幕识字（需联网），不会发送 Ctrl+C。主窗口工具栏也可开关。" />

                <TextBlock Text="文本引擎" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="EngineBing" Content="必应" GroupName="Engine" Checked="OnEngineChanged" />
                    <RadioButton x:Name="EngineLlm" Content="AI 大模型" GroupName="Engine" Checked="OnEngineChanged" />
                    <RadioButton x:Name="EngineOffline" Content="仅离线" GroupName="Engine" Checked="OnEngineChanged" />
                </StackPanel>
                <StackPanel x:Name="OfflinePanel" Spacing="6">
                    <TextBlock
                        x:Name="OfflinePackStatusText"
                        Opacity="0.85"
                        TextWrapping="Wrap"
                        Text="未安装语言包" />
                    <ProgressBar
                        x:Name="OfflinePackProgress"
                        Maximum="100"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OfflinePackDownloadButton" Content="下载英↔中语言包" Click="OnOfflinePackDownloadClick" />
                        <Button x:Name="OfflinePackDeleteButton" Content="删除" Click="OnOfflinePackDeleteClick" />
                    </StackPanel>
                    <TextBlock
                        Opacity="0.65"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Text="下载一次即可。必应/AI 失败或断网时自动改用离线，无需切换引擎。截屏 OCR 仍需联网。" />
                </StackPanel>

                <TextBlock Text="代理" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="ProxySystem" Content="系统代理" GroupName="Proxy" Checked="OnProxyChanged" />
                    <RadioButton x:Name="ProxyCustom" Content="自定义" GroupName="Proxy" Checked="OnProxyChanged" />
                    <RadioButton x:Name="ProxyNone" Content="不使用" GroupName="Proxy" Checked="OnProxyChanged" />
                </StackPanel>
                <TextBox
                    x:Name="CustomProxyBox"
                    Header="自定义代理 URL"
                    LostFocus="OnFieldCommit"
                    Visibility="Collapsed" />

                <StackPanel x:Name="LlmPanel" Spacing="8" Visibility="Collapsed">
                    <TextBox x:Name="LlmBaseUrlBox" Header="LLM Base URL" LostFocus="OnFieldCommit" />
                    <PasswordBox x:Name="LlmApiKeyBox" Header="API Key" PasswordChanged="OnLlmApiKeyChanged" />
                    <TextBox x:Name="LlmModelBox" Header="Model" LostFocus="OnFieldCommit" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="AutostartSwitch"
                    Header="开机自启"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnToggle" />
                <ToggleSwitch
                    x:Name="CompareOverlaySwitch"
                    Header="截屏对比图"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnToggle" />

                <TextBlock FontWeight="SemiBold" Text="应用更新" />
                <ToggleSwitch
                    x:Name="AutoUpdateSwitch"
                    Header="自动检查"
                    OffContent="关"
                    OnContent="开"
                    Toggled="OnToggle" />
                <TextBlock x:Name="UpdateStatusText" Opacity="0.75" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="UpdateNotesText"
                    Opacity="0.85"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdateClick" />
                    <Button
                        x:Name="ApplyUpdateButton"
                        Content="立即更新并重启"
                        Click="OnApplyUpdateClick"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Opacity="0.8" Text="截屏翻译热键" />
                    <Button
                        x:Name="HotkeyButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnHotkeyRecordClick"
                        ToolTipService.ToolTip="点击后按下快捷键；Backspace 清空" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Opacity="0.8" Text="OCR 复制热键" />
                    <Button
                        x:Name="CopyHotkeyButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnHotkeyRecordClick"
                        ToolTipService.ToolTip="点击后按下快捷键；Backspace 清空" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Opacity="0.8" Text="弹出主窗热键（可空）" />
                    <Button
                        x:Name="PopupHotkeyButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnHotkeyRecordClick"
                        ToolTipService.ToolTip="点击后按下快捷键；Backspace 清空；Esc 取消" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
