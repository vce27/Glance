<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Glance.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glance.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Glance Fluent accent (#0078D4), not OS #0067C0 -->
            <Color x:Key="GlanceAccentColor">#FF0078D4</Color>
            <SolidColorBrush x:Key="GlanceAccentBrush" Color="{StaticResource GlanceAccentColor}" />
            <SolidColorBrush x:Key="GlanceAccentSoftBrush" Color="#1F0078D4" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
